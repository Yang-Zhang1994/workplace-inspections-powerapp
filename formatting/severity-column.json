{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/column-formatting.schema.json",
  "elmType": "div",
  "style": {
    "padding": "2px 10px",
    "border-radius": "12px",
    "display": "inline-block",
    "font-weight": "600",
    "color": "#ffffff",
    "background-color": "=if(@currentField == 'High', '#c4314b', if(@currentField == 'Medium', '#ca7a00', if(@currentField == 'Low', '#2e7d32', '#8a8886')))"
  },
  "txtContent": "@currentField"
}
